DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
# Separate database for `npm test` (name must contain "test"); create/update it with `npm run test:db`.
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/life_organizer_test"
# Scratch database for `npx prisma migrate dev` / `migrate diff` only. Prisma wipes it on every run, so it must be
# its own database: never DATABASE_URL or TEST_DATABASE_URL. Not needed by migrate deploy, generate or the tests.
SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/life_organizer_shadow"
PORT=5000
NODE_ENV=development
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# AI: "ollama" (local, default) | "gemini" | "rules" (no LLM — deterministic pipeline only)
AI_ENABLED=true
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=60000
# Context window for Ollama requests (tokens)
OLLAMA_NUM_CTX=4096

# Semantic memory embeddings (pull once with: ollama pull nomic-embed-text)
EMBEDDINGS_ENABLED=true
EMBEDDING_MODEL=nomic-embed-text

# Optional Gemini (primary when AI_PROVIDER=gemini, or fallback when GEMINI_FALLBACK=true)
GEMINI_API_KEY=""
GEMINI_MODEL=gemini-3.8-flash
# Thinking tokens for Gemini (0 = off; short JSON jobs like check-in first steps need it off)
GEMINI_THINKING_BUDGET=0
# Background pacing between Gemini calls, and how long to skip Gemini after a 429 (503/timeouts: 30 s)
GEMINI_MIN_INTERVAL_MS=4000
GEMINI_RATE_LIMIT_COOLDOWN_MS=600000
GEMINI_TIMEOUT_MS=15000
GEMINI_FALLBACK=false

# Optional WhatsApp via Twilio (FR-WA, Pro only). Webhook: POST {PUBLIC_BASE_URL}/api/whatsapp/webhook
# Manual test steps: docs/whatsapp-e2e-checklist.md
TWILIO_ACCOUNT_SID=""
# Also verifies the webhook signature (X-Twilio-Signature).
TWILIO_AUTH_TOKEN=""
# The bot's WhatsApp number in E.164, e.g. +14155238886 (Twilio sandbox). Shown in the app's link screen.
TWILIO_WHATSAPP_FROM=""
# Public HTTPS base URL Twilio calls (e.g. the ngrok URL), no trailing slash. Must match exactly for signatures.
PUBLIC_BASE_URL=""
# Local testing only: accept webhooks without a Twilio signature (never set this on a public server).
# WHATSAPP_ALLOW_UNSIGNED=true

# Optional: Expo push access token, only if "enhanced security for push" is on in the Expo dashboard (docs/push-setup.md).
# EXPO_ACCESS_TOKEN=""

# Set to true to disable background jobs (purges, WhatsApp reminders)
DISABLE_JOBS=false

# Browser origins allowed to call the API (comma-separated, e.g. https://admin.example.com).
# The mobile app sends no Origin header and is always allowed. Unset: all origins in development, none in production.
# CORS_ORIGINS=

# Salt for pseudonymous user ids in scripts/checkin-report.ts exports (required to export; keep private)
REPORT_ID_SALT=""

# FR-LB-001 geocoding (OpenStreetMap Nominatim, free; max 1 request/s, cached 24 h). Override only for a self-hosted instance.
# NOMINATIM_URL="https://nominatim.openstreetmap.org"

# Chat routing. The meaning-based router (bank examples + arbitration) is off unless "on": the gate found no gain yet.
MEANING_ROUTER=off
# Messages no command fits are logged (masked, no user id) to logs/unknown-utterances.jsonl; "off" stops it.
UNKNOWN_LOG=on
# Size cap before the log is rotated to .1 (KB).
UNKNOWN_LOG_MAX_KB=512

# --- Hosted LLM providers (off unless a job chain is set; docs/providers.md, docs/rollout.md) ---
# Any non-Ollama provider at all. Off = every model call takes the baseline (Ollama) path, whatever the chains say.
# Masking is not anonymisation: see docs/rollout.md before turning this on.
CLOUD_FALLBACK=off
# Chains per job (with CLOUD_FALLBACK=on): providers allowed for that job, ordered by config/provider-order.json "chains". Unset = baseline (Ollama).
LLM_PROVIDERS_CHAT=
LLM_PROVIDERS_DOCS=
LLM_PROVIDERS_VISION=
# Tier B providers that may lead a chain (your written approval). Empty = none.
LLM_TIER_B_LEAD_APPROVED=
# Provider masking: "cues" (default: names after call/with/Dr/bhai) or "capitalised" (also every capitalised word).
LLM_MASK_NAMES=cues
# provider/latency/status/token log lines; "off" to silence.
LLM_LOG=on
# Keys (values only in backend/.env, never here):
GROQ_API_KEY=
CEREBRAS_API_KEY=
TOGETHER_API_KEY=
OPENROUTER_API_KEY=
DEPLOY_API_KEY_1=
DEPLOY_API_KEY_2=
# AWS Bedrock: disabled until there is AWS access (scripts/test-bedrock.ts).
BEDROCK_ENABLED=false
BEDROCK_MODEL=
BEDROCK_DAILY_BUDGET_USD=0
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
