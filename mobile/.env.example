# Primary API (used first after last-known-good). Use your Mac’s LAN IP when testing on a phone (not localhost).
EXPO_PUBLIC_API_BASE_URL="http://192.168.1.100:5050/api"

# Optional: extra full URLs to try (comma-separated), same port/path pattern as primary.
# EXPO_PUBLIC_API_FALLBACK_URLS="http://192.168.0.12:5050/api,http://10.0.0.5:5050/api"

# Optional: LAN IPs only — port is copied from EXPO_PUBLIC_API_BASE_URL (defaults to 5050 if missing).
# EXPO_PUBLIC_API_HOST_IPS="192.168.1.100,192.168.0.12,10.0.0.5"

# IPs typed on the “Could not reach the server” screen are saved in AsyncStorage and tried automatically next time.

EXPO_PUBLIC_FIREBASE_API_KEY=""
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=""
EXPO_PUBLIC_FIREBASE_PROJECT_ID=""
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=""
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
EXPO_PUBLIC_FIREBASE_APP_ID=""
