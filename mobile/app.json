{
  "expo": {
    "name": "Life Organizer",
    "slug": "life-organizer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/app-launch-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/branding/app-launch-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8FAFC"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Life Organizer to transcribe your speech into task text.",
        "NSMicrophoneUsageDescription": "Allow Life Organizer to use the microphone for voice tasks."
      },
      "bundleIdentifier": "com.anonymous.lifeorganizer"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/app-launch-icon.png",
        "backgroundColor": "#F8FAFC"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.VIBRATE"
      ],
      "package": "com.anonymous.lifeorganizer"
    },
    "web": {
      "favicon": "./assets/branding/app-launch-icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8FAFC",
          "image": "./assets/branding/app-launch-icon.png",
          "resizeMode": "contain",
          "android": {
            "backgroundColor": "#F8FAFC",
            "image": "./assets/branding/app-launch-icon.png",
            "resizeMode": "contain"
          },
          "ios": {
            "backgroundColor": "#F8FAFC",
            "image": "./assets/branding/app-launch-icon.png",
            "resizeMode": "contain"
          }
        }
      ],
      "expo-notifications",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Life Organizer to use the microphone for voice tasks.",
          "speechRecognitionPermission": "Allow Life Organizer to transcribe your speech into task text."
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
