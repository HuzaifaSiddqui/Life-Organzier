{
  "expo": {
    "name": "Life Organizer",
    "slug": "life-organizer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/app-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Life Organizer to transcribe your speech into task text.",
        "NSMicrophoneUsageDescription": "Allow Life Organizer to use the microphone for voice tasks."
      },
      "bundleIdentifier": "com.anonymous.lifeorganizer"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-foreground.png",
        "backgroundImage": "./assets/branding/adaptive-background.png",
        "backgroundColor": "#0A6FD6"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.VIBRATE"
      ],
      "package": "com.anonymous.lifeorganizer"
    },
    "web": {
      "favicon": "./assets/branding/app-icon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6F5F2",
          "image": "./assets/branding/splash-icon.png",
          "resizeMode": "contain",
          "android": {
            "backgroundColor": "#F6F5F2",
            "image": "./assets/branding/splash-icon.png",
            "resizeMode": "contain"
          },
          "ios": {
            "backgroundColor": "#F6F5F2",
            "image": "./assets/branding/splash-icon.png",
            "resizeMode": "contain"
          }
        }
      ],
      "expo-notifications",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Life Organizer to use the microphone for voice tasks.",
          "speechRecognitionPermission": "Allow Life Organizer to transcribe your speech into task text."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "./plugins/withLongPathCMake",
      "expo-font"
    ]
  }
}
